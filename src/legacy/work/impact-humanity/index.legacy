  <meta name="description" content="Impact Humanity case study by Daniel Myers: translating a Figma redesign into a responsive, optimized, SEO-ready Hostinger website.">
  <title>Impact Humanity Case Study | Daniel Myers, UI Engineer</title>
  <link rel="icon" type="image/x-icon" href="/assets/brand/DM-Logo.png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
